{
  "name": "richang",
  "productName": "Richang",
  "version": "0.1.0",
  "private": true,
  "description": "Richang - apprendre le chinois traditionnel du quotidien (Taiwan) : cartes, ecriture, ecoute, prononciation.",
  "author": "Nextale Audio",
  "license": "GPL-3.0-or-later",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "data:build": "node scripts/build-data.mjs",
    "data:validate": "node scripts/validate-words.mjs",
    "electron:dev": "node scripts/electron-dev.mjs",
    "electron:start": "npm run build && electron .",
    "electron:build": "npm run build && node scripts/electron-build.mjs",
    "android:sync": "npm run build && cap sync android",
    "android:open": "cap open android",
    "android:apk": "npm run build && cap sync android && node scripts/android-build.mjs",
    "data:dialogues": "node scripts/validate-dialogues.mjs"
  },
  "dependencies": {
    "@capacitor-community/speech-recognition": "^7.0.1",
    "@capacitor-community/text-to-speech": "^8.0.2",
    "@capacitor/app": "^8.1.1",
    "@capacitor/core": "^8.5.2",
    "@capacitor/filesystem": "^8.1.3",
    "@fontsource-variable/nunito": "^5.3.0",
    "hanzi-writer": "^3.7.3",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@capacitor/android": "^8.5.2",
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^8.5.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "electron": "^44.4.3",
    "electron-builder": "^26.15.3",
    "hanzi-writer-data": "^2.0.1",
    "sharp": "^0.35.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.0"
  }
}
